		"@types/node": "^16.18.126",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "^0.28.1",
		"obsidian": "^1.8.7",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OwainWilliams/umbPublisher.git"
	},
	"bugs": {
		"url": "https://github.com/OwainWilliams/umbPublisher/issues"
